# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
# keep the safe example template
!.env.example

# ── Production data — NEVER commit SQL dumps or real data exports ─────────────
*.sql
docker/mysql/init/*.sql
# keep the placeholder that marks the directory in Git
!docker/mysql/init/.gitkeep

# ── Frontend build outputs ────────────────────────────────────────────────────
frontend/node_modules/
frontend/.output/
frontend/.wrangler/
frontend/.vinxi/
frontend/.tanstack/
frontend/dist/
frontend/.nitro/

# ── Backend build output ──────────────────────────────────────────────────────
backend/target/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temporary backups ────────────────────────────────────────────────────────
*.bak
*.backup
tmp/
temp/
