# Copy this file to .env and fill in the real values before running Docker Compose.
# The .env file is listed in .gitignore and will never be committed.

# ── MySQL / Backend credentials ───────────────────────────────────────────────
# Password used by both the MySQL root user and the Spring Boot datasource.
DB_PASSWORD=change_me_before_demo

# Database username passed to Spring Boot (default: root)
DB_USERNAME=root

# MySQL database name (default: sebn_dashboard)
MYSQL_DATABASE=sebn_dashboard

# Data mode label exposed on /api/dashboard/data-freshness.
# IMPORTED = data was loaded from a dataset dump (default).
# LIVE     = set only when a real WAO-to-MySQL sync process is running.
DATA_MODE=IMPORTED
